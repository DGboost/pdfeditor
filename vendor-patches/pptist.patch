new file mode 100644
index 0000000000000000000000000000000000000000..6a4de1bb72e21944f8790964f8c9b7c9cd39bb6a
--- /dev/null
+++ b/src/embed/assets.ts
@@ -0,0 +1,75 @@
+import type { Slide } from '@/types/slides'
+import { getOwnedMediaBlob, ownMediaURL } from './hostEvents'
+
+type Payload = { slides: Slide[] }
+// Blobs are immutable; weak keys let session disposal release cached media.
+const mediaHashes = new WeakMap<Blob, string>()
+// Visit only declared media locations; text, HTML, hyperlinks and arbitrary strings are never assets.
+function mediaFields(payload: Payload, visit: (owner: { [key: string]: unknown }, key: string) => void) {
+  for (const slide of payload.slides) {
+    if (slide.background?.image) visit(slide.background.image as unknown as Record<string, unknown>, 'src')
+    for (const element of slide.elements) {
+      if (element.type === 'image' || element.type === 'video' || element.type === 'audio') {
+        visit(element as unknown as Record<string, unknown>, 'src')
+        if (element.type === 'video' && element.poster) visit(element as unknown as Record<string, unknown>, 'poster')
+      }
+      if (element.type === 'shape' && element.pattern) visit(element as unknown as Record<string, unknown>, 'pattern')
+    }
+  }
+}
+
+export function restoreAssets<T extends Payload>(payload: T, assets: { id: string; blob: Blob }[]): T {
+  const copy = structuredClone(payload)
+  const urls = new Map<string, string>()
+  for (const asset of assets) {
+    if (urls.has(asset.id) || !(asset.blob instanceof Blob)) throw new Error('잘못된 PPTX 미디어 체크포인트입니다.')
+    urls.set(asset.id, ownMediaURL(asset.blob))
+  }
+  mediaFields(copy, (owner, key) => {
+    const value = owner[key]
+    if (typeof value === 'string' && value.startsWith('pdfe-asset:')) {
+      const url = urls.get(value.slice(11))
+      if (!url) throw new Error('PPTX 체크포인트 미디어가 누락되었습니다.')
+      owner[key] = url
+    }
+  })
+  return copy
+}
+
+export async function captureAssets<T extends Payload>(payload: T): Promise<{ payload: T; assets: { id: string; blob: Blob }[] }> {
+  const copy = structuredClone(payload)
+  const locations = new Map<string, { owner: Record<string, unknown>; key: string }[]>()
+  mediaFields(copy, (owner, key) => {
+    const value = owner[key]
+    if (typeof value === 'string' && value.startsWith('blob:')) {
+      const list = locations.get(value) || []
+      list.push({ owner, key })
+      locations.set(value, list)
+    }
+  })
+  const assets: { id: string; blob: Blob }[] = []
+  const hashes = new Map<string, string>()
+  for (const [url, fields] of locations) {
+    let blob = getOwnedMediaBlob(url)
+    if (!blob) {
+      const response = await fetch(url)
+      if (!response.ok) throw new Error('PPTX 미디어를 읽을 수 없습니다.')
+      blob = await response.blob()
+    }
+    let hash = mediaHashes.get(blob)
+    if (!hash) {
+      const digest = await crypto.subtle.digest('SHA-256', await blob.arrayBuffer())
+      hash = blob.type + ':' + Array.from(new Uint8Array(digest), byte => byte.toString(16).padStart(2, '0')).join('')
+      mediaHashes.set(blob, hash)
+    }
+    let id = hashes.get(hash)
+    if (!id) {
+      id = crypto.randomUUID()
+      hashes.set(hash, id)
+      assets.push({ id, blob })
+    }
+    for (const { owner, key } of fields) owner[key] = `pdfe-asset:${id}`
+  }
+  return { payload: copy, assets }
+}
+
diff --git a/src/embed/hostBridge.ts b/src/embed/hostBridge.ts
new file mode 100644
index 0000000000000000000000000000000000000000..4381957820e477b697141c7f690c923688c48390
--- /dev/null
+++ b/src/embed/hostBridge.ts
@@ -0,0 +1,190 @@
+import { nextTick, watch } from 'vue'
+import { useMainStore, useSlidesStore, useSnapshotStore } from '@/store'
+import useImport, { getImportWarnings } from '@/hooks/useImport'
+import useExport, { type NativePayload } from '@/hooks/useExport'
+import { flushHistory, disposeHistory } from '@/hooks/useHistorySnapshot'
+import { FONTS } from '@/configs/font'
+import { serveOfficeFrame } from '../../../../src/documents/frameBridge'
+import type { OfficeSession, OfficeState, OfficeFrameOpen } from '../../../../src/documents/officeTypes'
+import { flushText, cancelTextFlush, executeText, textState, subscribeText } from './textRuntime'
+import { captureAssets, restoreAssets } from './assets'
+import { releaseMediaURLs } from './hostEvents'
+
+export function initializeOfficeHost(): () => void {
+  const main = useMainStore()
+  const slides = useSlidesStore()
+  const history = useSnapshotStore()
+  const importer = useImport()
+  const exporter = useExport()
+  let active: OfficeSession | undefined
+  const bridge = serveOfficeFrame(async (request: OfficeFrameOpen, sessionId: string) => {
+    try {
+    if (request.format !== 'pptx') throw new Error('PPTX 문서만 열 수 있습니다.')
+    if (active) throw new Error('PPTX 문서는 새 세션에서 열어 주세요.')
+    await history.initSnapshotDatabase()
+    let warnings: string[] = []
+    if (request.checkpoint) {
+      if (request.checkpoint.kind !== 'pptist') throw new Error('PPTX 체크포인트 형식이 일치하지 않습니다.')
+      const payload = restoreAssets(request.checkpoint.payload as Parameters<typeof importer.restoreNativePayload>[0], request.checkpoint.assets)
+      await importer.restoreNativePayload(payload)
+      warnings = getImportWarnings()
+    }
+    else {
+      await importer.importPPTXFile([new File([request.source], request.fileName, { type: request.source.type })])
+      warnings = getImportWarnings()
+    }
+    await nextTick()
+    await document.fonts.ready
+    await new Promise<void>(resolve => requestAnimationFrame(() => requestAnimationFrame(() => resolve())))
+    if (!document.querySelector('.pptist-editor .canvas')) throw new Error('PPTX 첫 화면을 표시하지 못했습니다.')
+    let revision = request.initialRevision
+    let selectionRevision = 0
+    let busy = false
+    let disposed = false
+    let queue: Promise<unknown> = Promise.resolve()
+    const listeners = new Set<(state: OfficeState) => void>()
+    const unavailable = { kind: 'unavailable' as const, reason: '텍스트를 선택하세요.' }
+    const getState = (): OfficeState => {
+      const text = textState()
+      const blocked = busy || !!text?.composing || disposed
+      const canUndo = text ? text.canUndo : history.canUndo
+      const canRedo = text ? text.canRedo : history.canRedo
+      return {
+        sessionId, revision, selectionRevision, ready: !disposed, busy, composing: !!text?.composing,
+        canSaveModified: true,
+        canUndo, canRedo, zoom: main.canvasScale,
+        enabled: {
+          undo: !blocked && canUndo, redo: !blocked && canRedo,
+          bold: !blocked && !!text?.enabled.bold, italic: !blocked && !!text?.enabled.italic,
+          underline: !blocked && !!text?.enabled.underline, fontFamily: !blocked && !!text?.enabled.fontFamily,
+          fontSize: !blocked && !!text?.enabled.fontSize, color: !blocked && !!text?.enabled.color, zoom: !blocked,
+        },
+        formatting: text?.formatting || { bold: unavailable, italic: unavailable, underline: unavailable, fontFamily: unavailable, fontSize: unavailable, color: unavailable },
+        fonts: FONTS.filter(font => font.value), warnings: [...warnings],
+      }
+    }
+    const publish = () => { if (!disposed) for (const listener of listeners) listener(getState()) }
+    const stopContent = watch(() => [slides.slides, slides.theme, slides.viewportSize, slides.viewportRatio], () => {
+      revision++
+      publish()
+    }, { deep: true, flush: 'sync' })
+    const stopSelection = watch(() => [main.activeElementIdList, main.handleElementId, main.selectedTableCells, slides.slideIndex], () => {
+      selectionRevision++
+      publish()
+    }, { deep: true, flush: 'sync' })
+    const stopZoom = watch(() => main.canvasScale, publish, { flush: 'sync' })
+    const stopHistory = watch(() => [history.canUndo, history.canRedo], publish)
+    const stopText = subscribeText(() => { selectionRevision++; publish() })
+    const flush = async () => {
+      if (disposed) throw new DOMException('PPTX 세션이 종료되었습니다.', 'AbortError')
+      await flushText()
+      await nextTick()
+      await flushHistory()
+      if (disposed) throw new DOMException('PPTX 세션이 종료되었습니다.', 'AbortError')
+      return true
+    }
+    const stable = <T>(operation: (atRevision: number, payload: NativePayload) => Promise<T>): Promise<T> => {
+      const task = queue.then(async () => {
+        await flush()
+        // History IO can yield to a new composition; recheck immediately before taking the UI lock.
+        await flushText()
+        if (disposed) throw new DOMException('PPTX 세션이 종료되었습니다.', 'AbortError')
+        busy = true
+        // Panels are siblings of the canvas and dialogs teleport to body. Lock the entire native UI.
+        // The first flush above waits for real composition completion before inert can move focus.
+        const wasInert = document.body.inert
+        document.body.inert = true
+        publish()
+        try {
+          await flush()
+          const payload = exporter.captureNativePayload()
+          return await operation(revision, payload)
+        }
+        finally { busy = false; document.body.inert = disposed || wasInert; publish() }
+      })
+      queue = task.catch(() => undefined)
+      return task
+    }
+    const session: OfficeSession = {
+      getState,
+      subscribe(listener) { listeners.add(listener); return () => listeners.delete(listener) },
+      async execute(command) {
+        if (!getState().enabled[command.type]) return { ok: false, reason: '현재 문맥에서 사용할 수 없는 명령입니다.' }
+        if (command.type === 'zoom') {
+          if (!Number.isFinite(command.value) || command.value < 0.1 || command.value > 5) return { ok: false, reason: '배율 범위를 벗어났습니다.' }
+          main.setCanvasPercentage(command.value / main.canvasScale * main.canvasPercentage)
+          await nextTick()
+          return { ok: true }
+        }
+        if (textState()) return executeText(command)
+        if (command.type === 'undo' || command.type === 'redo') {
+          await flushHistory()
+          if (command.type === 'undo') await history.unDo()
+          else await history.reDo()
+          await nextTick()
+          return { ok: true }
+        }
+        return { ok: false, reason: '텍스트를 선택하세요.' }
+      },
+      flush,
+      captureCheckpoint: () => stable(async (atRevision, payload) => {
+        const checkpoint = await captureAssets(payload)
+        return { revision: atRevision, checkpoint: { kind: 'pptist' as const, ...checkpoint } }
+      }),
+      serialize: () => stable(async (atRevision, payload) => {
+        const bytes = await exporter.exportPPTX(payload.slides, false, false, payload)
+        if (!(bytes instanceof Blob) || !bytes.size) throw new Error('PPTX 내보내기 결과가 비어 있습니다.')
+        // PPTX 내보내기는 요소 애니메이션·화면 전환을 직렬화하지 않는다.
+        const hasEffects = payload.slides.some(slide => (slide.animations?.length ?? 0) > 0 || (slide.turningMode && slide.turningMode !== 'no'))
+        const effectWarning = hasEffects ? ['슬라이드 애니메이션·화면 전환은 PPTX 수정본에 저장되지 않습니다. 작업 사본에서만 재생됩니다.'] : []
+        return { revision: atRevision, bytes, warnings: [...warnings, ...effectWarning] }
+      }),
+      dispose() {
+        if (disposed) return
+        disposed = true
+        stopContent(); stopSelection(); stopZoom(); stopHistory(); stopText()
+        listeners.clear()
+        cancelTextFlush()
+        releaseMediaURLs()
+        document.body.inert = true
+        void queue.finally(() => disposeHistory()).catch(error => console.error('PPTX history disposal failed', error))
+      },
+    }
+    active = session
+    return session
+    }
+    catch (error) {
+      if (!active) {
+        await disposeHistory().catch(cleanupError => console.error('PPTX history disposal failed', cleanupError))
+        releaseMediaURLs()
+      }
+      throw error
+    }
+  })
+  const save = () => bridge.requestSave()
+  const open = (event: Event) => {
+    const file = (event as CustomEvent<unknown>).detail
+    if (!(file instanceof File)) return
+    if (/\.(pptist|json)$/i.test(file.name)) bridge.reportError('PPTist/JSON 파일은 지원하지 않습니다. PPTX 파일을 열어 주세요.')
+    else bridge.requestOpen(file)
+  }
+  const error = (event: Event) => bridge.reportError(String((event as CustomEvent).detail))
+  window.addEventListener('pdfe-save-intent', save)
+  window.addEventListener('pdfe-open-request', open)
+  window.addEventListener('pdfe-error', error)
+  const stopNativeExport = watch(() => main.dialogForExport, value => {
+    if (value) { main.setDialogForExport(''); bridge.requestSave() }
+  }, { flush: 'sync' })
+  const disposeDocument = () => {
+    if (active) active.dispose()
+    else void disposeHistory().catch(error => console.error('PPTX history disposal failed', error))
+  }
+  window.addEventListener('pagehide', disposeDocument, { once: true })
+  return () => {
+    disposeDocument(); bridge.dispose(); stopNativeExport()
+    window.removeEventListener('pagehide', disposeDocument)
+    window.removeEventListener('pdfe-save-intent', save)
+    window.removeEventListener('pdfe-open-request', open)
+    window.removeEventListener('pdfe-error', error)
+  }
+}
