--- /dev/null
+++ b/src/embed/hostEvents.ts
@@ -0,0 +1,24 @@
+const ownedURLs = new Map<string, Blob>()
+
+export function ownMediaURL(blob: Blob): string {
+  const url = URL.createObjectURL(blob)
+  ownedURLs.set(url, blob)
+  return url
+}
+
+export function getOwnedMediaBlob(url: string): Blob | undefined {
+  return ownedURLs.get(url)
+}
+
+export function releaseMediaURLs(): void {
+  for (const url of ownedURLs.keys()) URL.revokeObjectURL(url)
+  ownedURLs.clear()
+}
+
+export function requestHostOpen(file: File): void {
+  if (/\.(pptist|json)$/i.test(file.name)) {
+    window.dispatchEvent(new CustomEvent('pdfe-error', { detail: 'PPTist/JSON 파일은 지원하지 않습니다. PPTX 파일을 열어 주세요.' }))
+    return
+  }
+  window.dispatchEvent(new CustomEvent('pdfe-open-request', { detail: file }))
+}
diff --git a/src/embed/textRuntime.ts b/src/embed/textRuntime.ts
new file mode 100644
index 0000000000000000000000000000000000000000..13b7770c8a59326c8615e148a0d4a1243d308e16
--- /dev/null
+++ b/src/embed/textRuntime.ts
@@ -0,0 +1,235 @@
+import { nextTick } from 'vue'
+import type { Mark } from 'prosemirror-model'
+import type { Transaction } from 'prosemirror-state'
+import type { EditorView } from 'prosemirror-view'
+import { undoDepth, redoDepth } from 'prosemirror-history'
+import type { CommandResult, FormatValue, OfficeCommand, OfficeState } from '../../../../src/documents/officeTypes'
+import type { RichTextAction } from '@/utils/emitter'
+import tinycolor from 'tinycolor2'
+
+interface TextRegistration {
+  view: EditorView
+  flush: () => void
+  execute: (action: RichTextAction) => void
+  history: (command: 'undo' | 'redo') => boolean
+  defaults: () => { color: string; fontFamily: string; fontSize?: string }
+}
+
+export interface TextEntry extends Omit<TextRegistration, 'flush'> {
+  readonly composing: boolean
+  activate(): void
+  deactivate(): void
+  changed(transaction: Transaction): void
+  composition(value: boolean): void
+  restoreSelection(): void
+  flush(): Promise<void>
+  cancelFlush(): void
+  dispose(): void
+}
+
+const listeners = new Set<() => void>()
+const entries = new Set<TextEntry>()
+let active: TextEntry | null = null
+const notify = () => listeners.forEach(listener => listener())
+
+function createEntry(options: TextRegistration): TextEntry {
+  const { view } = options
+  // ProseMirror exposes no public observer barrier; this internal API commits native DOM input.
+  const observedView = view as unknown as { domObserver: { flush: () => void } }
+  let bookmark = view.state.selection.getBookmark()
+  let composing = false
+  let disposed = false
+  let cancellation: DOMException | undefined
+  const compositionWaiters = new Set<{ resolve: () => void; reject: (error: DOMException) => void }>()
+  const assertLive = () => {
+    if (cancellation) throw cancellation
+  }
+  const entry = {
+    ...options,
+    get composing() { return composing },
+    activate() {
+      if (disposed) return
+      bookmark = view.state.selection.getBookmark()
+      active = entry
+      notify()
+    },
+    deactivate() {
+      if (active !== entry) return
+      active = null
+      notify()
+    },
+    changed(transaction: Transaction) {
+      bookmark = bookmark.map(transaction.mapping)
+      if (transaction.selectionSet) bookmark = transaction.selection.getBookmark()
+      notify()
+    },
+    composition(value: boolean) {
+      composing = value
+      if (!value) {
+        compositionWaiters.forEach(waiter => waiter.resolve())
+        compositionWaiters.clear()
+      }
+      notify()
+    },
+    restoreSelection() {
+      const selection = bookmark.resolve(view.state.doc)
+      if (!selection.eq(view.state.selection)) view.dispatch(view.state.tr.setSelection(selection))
+    },
+    async flush() {
+      assertLive()
+      if (composing) await new Promise<void>((resolve, reject) => compositionWaiters.add({ resolve, reject }))
+      assertLive()
+      // ProseMirror owns DOM parsing; flushing its observer commits pending native input.
+      observedView.domObserver.flush()
+      options.flush()
+      await nextTick()
+      assertLive()
+      observedView.domObserver.flush()
+      options.flush()
+      await nextTick()
+      assertLive()
+    },
+    cancelFlush() {
+      cancellation ??= new DOMException('PPTX text flush cancelled', 'AbortError')
+      compositionWaiters.forEach(waiter => waiter.reject(cancellation!))
+      compositionWaiters.clear()
+    },
+    dispose() {
+      if (disposed) return
+      if (!cancellation && !composing) {
+        observedView.domObserver.flush()
+        options.flush()
+      }
+      disposed = true
+      entry.cancelFlush()
+      entry.deactivate()
+      entries.delete(entry)
+      if (!entries.size) document.removeEventListener('pointerdown', documentPointerDown, true)
+    },
+  }
+  return entry
+}
+
+function documentPointerDown(event: PointerEvent) {
+  if (active && event.target instanceof Node && !active.view.dom.contains(event.target)) {
+    // Capture runs before slide/object handlers can change the destination of content updates.
+    const previous = active
+    void previous.flush().catch(error => {
+      if (!(error instanceof DOMException && error.name === 'AbortError')) {
+        window.dispatchEvent(new CustomEvent('pdfe-error', { detail: String(error) }))
+      }
+    })
+    previous.deactivate()
+  }
+}
+
+export function registerText(options: TextRegistration) {
+  if (!entries.size) document.addEventListener('pointerdown', documentPointerDown, true)
+  const entry = createEntry(options)
+  entries.add(entry)
+  return entry
+}
+
+export async function flushText(): Promise<void> {
+  await Promise.all([...entries].map(entry => entry.flush()))
+}
+
+export function cancelTextFlush(): void {
+  for (const entry of entries) entry.cancelFlush()
+}
+
+export function subscribeText(listener: () => void): () => void {
+  listeners.add(listener)
+  return () => { listeners.delete(listener) }
+}
+
+function aggregate<T>(values: T[]): FormatValue<T> {
+  if (!values.length) return { kind: 'unavailable', reason: 'No text selection' }
+  return values.every(value => value === values[0])
+    ? { kind: 'uniform', value: values[0] }
+    : { kind: 'mixed' }
+}
+
+export function textState(): {
+  composing: boolean
+  canUndo: boolean
+  canRedo: boolean
+  formatting: OfficeState['formatting']
+  enabled: Partial<OfficeState['enabled']>
+} | null {
+  if (!active) return null
+  const { state } = active.view
+  const { selection } = state
+  const runs: (readonly Mark[])[] = []
+  if (selection.empty) runs.push(state.storedMarks ?? selection.$from.marks())
+  else state.doc.nodesBetween(selection.from, selection.to, node => {
+    if (node.isText) runs.push(node.marks)
+  })
+  const defaults = active.defaults()
+  const booleanMark = (name: string) => aggregate(runs.map(marks => marks.some(mark => mark.type.name === name)))
+  const attribute = (marks: readonly Mark[], name: string, key: string, fallback: string): string =>
+    marks.find(mark => mark.type.name === name)?.attrs[key] || fallback
+  const families = runs.map(marks => attribute(marks, 'fontname', 'fontname', defaults.fontFamily).trim())
+  const colors = runs.map(marks => tinycolor(attribute(marks, 'forecolor', 'color', defaults.color)))
+  const sizes = runs.map(marks => {
+    const size = attribute(marks, 'fontsize', 'fontsize', defaults.fontSize || '16px')
+    return parseFloat(size) * (size.endsWith('pt') ? 1 : 0.75)
+  })
+  const canUndo = undoDepth(state) > 0
+  const canRedo = redoDepth(state) > 0
+  const enabled = !active.composing && active.view.editable
+  return {
+    composing: active.composing,
+    canUndo,
+    canRedo,
+    formatting: {
+      bold: booleanMark('strong'),
+      italic: booleanMark('em'),
+      underline: booleanMark('underline'),
+      fontFamily: families.some(family => !family)
+        ? { kind: 'unavailable', reason: 'Font family is not specified' }
+        : aggregate(families),
+      fontSize: sizes.some(size => !Number.isFinite(size) || size <= 0)
+        ? { kind: 'unavailable', reason: 'Font size cannot be resolved' }
+        : aggregate(sizes),
+      color: colors.some(color => !color.isValid())
+        ? { kind: 'unavailable', reason: 'Text color cannot be resolved' }
+        : aggregate(colors.map(color => color.toHexString().toUpperCase())),
+    },
+    enabled: {
+      undo: enabled && canUndo, redo: enabled && canRedo,
+      bold: enabled, italic: enabled, underline: enabled,
+      fontFamily: enabled, fontSize: enabled, color: enabled,
+    },
+  }
+}
+
+export async function executeText(command: OfficeCommand): Promise<CommandResult> {
+  const entry = active
+  if (!entry || !entry.view.editable) return { ok: false, reason: 'No active text editor' }
+  if (entry.composing) return { ok: false, reason: 'Text composition is active' }
+  if (command.type === 'zoom') return { ok: false, reason: 'Zoom is not a text command' }
+  await entry.flush()
+  if (active !== entry) return { ok: false, reason: 'Text context changed' }
+  if (entry.composing) return { ok: false, reason: 'Text composition is active' }
+  entry.restoreSelection()
+  if (command.type === 'undo' || command.type === 'redo') {
+    const changed = entry.history(command.type)
+    if (!changed) return { ok: false, reason: `Nothing to ${command.type}` }
+  }
+  else {
+    let action: RichTextAction
+    switch (command.type) {
+      case 'bold': action = { command: 'bold' }; break
+      case 'italic': action = { command: 'em' }; break
+      case 'underline': action = { command: 'underline' }; break
+      case 'fontFamily': action = { command: 'fontname', value: command.value }; break
+      case 'fontSize': action = { command: 'fontsize', value: `${command.value / 0.75}px` }; break
+      case 'color': action = { command: 'color', value: command.value }; break
+    }
+    entry.execute(action)
+  }
+  await entry.flush()
+  notify()
+  return { ok: true }
+}
